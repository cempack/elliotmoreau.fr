---
import { locations } from '../config/globe';

const visited = locations.filter((location) => location.type === 'visited');
const wishlist = locations.filter((location) => location.type === 'wishlist');
---

<section class="globe-section animate-on-scroll deferred-section" id="globe-widget">
  <div class="globe__header">
    <div class="section-header__left">
      <span class="material-symbols-outlined">public</span>
      <div>
        <span class="label-upper">Coordinate archive</span>
        <h2 class="text-title globe__title">World Map</h2>
      </div>
    </div>
    <p class="globe__subtitle">Places already explored and places still glowing on the horizon.</p>
  </div>

  <div class="globe__layout card card-paper">
    <div class="globe__canvas-wrap">
      <div class="globe__atmosphere"></div>
      <canvas id="globe-canvas" width="600" height="600"></canvas>
      <div class="globe__orbit"></div>
      <div class="globe__orbit globe__orbit--2"></div>
    </div>

    <div class="globe__info">
      <div class="globe__list">
        <div class="globe__list-group">
          <span class="globe__list-label">
            <span class="globe__dot globe__dot--visited"></span>
            Been there
          </span>
          <div class="globe__list-items">
            {visited.map((location) => <span class="globe__place">{location.name}</span>)}
          </div>
        </div>

        <div class="globe__list-group">
          <span class="globe__list-label">
            <span class="globe__dot globe__dot--wishlist"></span>
            Want to go
          </span>
          <div class="globe__list-items">
            {wishlist.map((location) => <span class="globe__place globe__place--wish">{location.name}</span>)}
          </div>
        </div>
      </div>

      <div class="globe__stats">
        <div class="globe__stat">
          <span class="globe__stat-num">{visited.length}</span>
          <span class="label-sm">Countries visited</span>
        </div>
        <div class="globe__stat">
          <span class="globe__stat-num">{wishlist.length}</span>
          <span class="label-sm">Future destinations</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .globe-section {
    margin-bottom: 3rem;
  }

  .globe__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .globe__title {
    font-size: 1.5rem;
    margin-top: 0.3rem;
  }

  .globe__subtitle {
    max-width: 24rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .globe__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 1.4rem;
  }

  @media (min-width: 880px) {
    .globe__layout {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .globe__canvas-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    max-width: 460px;
    margin: 0 auto;
  }

  .globe__atmosphere {
    position: absolute;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 68%);
    filter: blur(24px);
    animation: float-gentle 8s ease-in-out infinite;
  }

  .globe__orbit {
    position: absolute;
    width: 106%;
    height: 106%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    opacity: 0.22;
    transform: rotateX(72deg) rotateZ(18deg);
    animation: spin-vinyl 26s linear infinite;
  }

  .globe__orbit--2 {
    width: 116%;
    height: 116%;
    border-style: dashed;
    opacity: 0.12;
    animation-duration: 34s;
    animation-direction: reverse;
  }

  #globe-canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .globe__info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .globe__list {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .globe__list-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .globe__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .globe__dot--visited {
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .globe__dot--wishlist {
    border: 1.5px dashed var(--text-muted);
  }

  .globe__list-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .globe__place {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.82rem;
    border: 1px solid var(--outline);
    border-radius: 999px;
    background: var(--surface-high);
    color: var(--text-body);
    font-family: var(--font-label);
    font-size: 0.66rem;
  }

  .globe__place--wish {
    border-style: dashed;
  }

  .globe__stats {
    display: flex;
    gap: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .globe__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .globe__stat-num {
    color: var(--accent);
    font-family: var(--font-headline);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  @media (max-width: 768px) {
    .globe__stats {
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe__atmosphere,
    .globe__orbit {
      animation: none;
    }
  }
</style>

<script>
  import createGlobe from 'cobe';

  const globeSection = document.getElementById('globe-widget');
  const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
  let globe: any = null;
  let globeVisible = false;
  let pointerDown = false;
  let pointerX = 0;
  let pointerY = 0;
  let width = canvas?.offsetWidth || 0;
  let phi = 0;
  let theta = 0.25;
  let dpr = 2;
  let buildFrame = 0;
  let retryCount = 0;

  function colorFromVar(name: string, fallback: [number, number, number]): [number, number, number] {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    if (value.startsWith('#') && value.length >= 7) {
      return [
        parseInt(value.slice(1, 3), 16) / 255,
        parseInt(value.slice(3, 5), 16) / 255,
        parseInt(value.slice(5, 7), 16) / 255,
      ];
    }
    return fallback;
  }

  const markers = [
    { location: [46.6, 1.89], size: 0.1 },
    { location: [56.13, -106.35], size: 0.08 },
    { location: [53.14, -7.69], size: 0.07 },
    { location: [54.79, -6.49], size: 0.06 },
    { location: [28.29, -16.63], size: 0.06 },
    { location: [40.46, -3.75], size: 0.07 },
    { location: [36.2, 138.25], size: 0.07 },
    { location: [37.09, -95.71], size: 0.08 },
    { location: [-30.56, 22.94], size: 0.07 },
    { location: [60.47, 8.47], size: 0.07 },
  ];

  function getGlobeTheme() {
    const accent = colorFromVar('--accent', [1, 0.36, 0.36]);
    const bg = colorFromVar('--bg', [0.04, 0.03, 0.03]);

    return {
      accent,
      bg,
      baseColor: [bg[0] * 2.4 + 0.1, bg[1] * 2.4 + 0.1, bg[2] * 2.4 + 0.1] as [number, number, number],
      glowColor: [accent[0] * 0.22, accent[1] * 0.22, accent[2] * 0.22] as [number, number, number],
    };
  }

  function buildGlobe() {
    if (!canvas || globe || document.hidden) return;

    width = Math.round(canvas.offsetWidth);
    if (width < 40) return;

    const theme = getGlobeTheme();
    dpr = document.documentElement.dataset.performance === 'lite' ? 1.4 : 2;

    globe = createGlobe(canvas, {
      devicePixelRatio: dpr,
      width: width * dpr,
      height: width * dpr,
      phi,
      theta,
      dark: 1,
      diffuse: 1.3,
      mapSamples: document.documentElement.dataset.performance === 'lite' ? 18000 : 30000,
      mapBrightness: 1.8,
      mapBaseBrightness: 0.12,
      baseColor: theme.baseColor,
      markerColor: theme.accent,
      glowColor: theme.glowColor,
      markers,
      onRender: (state) => {
        if (!pointerDown) {
          phi += document.documentElement.dataset.motion === 'reduced' ? 0.001 : 0.0035;
        }
        state.phi = phi;
        state.theta = theta;
        state.width = width * dpr;
        state.height = width * dpr;
      },
    });
  }

  function updateGlobeTheme() {
    if (!globe) return;
    const theme = getGlobeTheme();
    globe.update({
      baseColor: theme.baseColor,
      markerColor: theme.accent,
      glowColor: theme.glowColor,
    });
  }

  function scheduleBuild() {
    if (buildFrame) {
      cancelAnimationFrame(buildFrame);
    }

    buildFrame = requestAnimationFrame(() => {
      buildFrame = 0;

      if (!canvas || document.hidden) return;
      if (!globeVisible && document.documentElement.dataset.performance === 'lite') return;

      const nextWidth = Math.round(canvas.offsetWidth);
      if (nextWidth < 40) {
        if (retryCount < 10) {
          retryCount += 1;
          scheduleBuild();
        }
        return;
      }

      retryCount = 0;
      buildGlobe();
    });
  }

  function destroyGlobe() {
    if (buildFrame) {
      cancelAnimationFrame(buildFrame);
      buildFrame = 0;
    }
    if (globe) {
      globe.destroy();
      globe = null;
    }
  }

  if (canvas) {
    canvas.addEventListener('pointerdown', (event) => {
      pointerDown = true;
      pointerX = event.clientX;
      pointerY = event.clientY;
    });

    window.addEventListener('pointerup', () => {
      pointerDown = false;
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (!pointerDown) return;
        const dx = event.clientX - pointerX;
        const dy = event.clientY - pointerY;
        pointerX = event.clientX;
        pointerY = event.clientY;
        phi += dx / 220;
        theta = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, theta - dy / 220));
      },
      { passive: true }
    );

    const resizeObserver = new ResizeObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      width = entry.contentRect.width;
      if (globe) {
        globe.update({ width: width * dpr, height: width * dpr });
      } else if (globeVisible) {
        scheduleBuild();
      }
    });
    resizeObserver.observe(canvas);
  }

  if (globeSection) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          globeVisible = entry.isIntersecting;
          if (globeVisible) {
            scheduleBuild();
          } else if (document.documentElement.dataset.performance === 'lite') {
            destroyGlobe();
          }
        });
      },
      { threshold: 0.2 }
    );

    sectionObserver.observe(globeSection);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      destroyGlobe();
    } else if (globeSection && globeSection.getBoundingClientRect().top < window.innerHeight) {
      globeVisible = true;
      scheduleBuild();
    }
  });

  window.addEventListener('themechange', () => {
    if (globe) {
      updateGlobeTheme();
    } else {
      scheduleBuild();
    }
  });

  window.addEventListener('pageshow', () => {
    if (globeSection && globeSection.getBoundingClientRect().top < window.innerHeight) {
      globeVisible = true;
      scheduleBuild();
    }
  });

  window.addEventListener('load', () => {
    if (globeSection && globeSection.getBoundingClientRect().top < window.innerHeight) {
      globeVisible = true;
      scheduleBuild();
    }
  });
</script>
