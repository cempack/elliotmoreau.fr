---
---

<section class="spotify-section animate-on-scroll deferred-section" id="spotify-widget">
  <div class="spotify-header">
    <div class="spotify-header__left">
      <svg class="spotify-icon" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"></path>
      </svg>
      <div>
        <span class="label-upper spotify-header__eyebrow">Audio Presence</span>
        <h2 class="text-title spotify-header__title">Soundscape</h2>
      </div>
    </div>
    <span class="spotify-label label-sm">Live feed</span>
  </div>

  <div class="spotify-bento" id="spotify-bento-grid" aria-live="polite">
    <div class="spotify-bento__main card card-paper">
      <div class="spotify-now__loading">
        <div class="spotify-now__skeleton"></div>
        <div class="spotify-now__skeleton-text">
          <div class="skeleton-line" style="width:60%"></div>
          <div class="skeleton-line" style="width:38%"></div>
          <div class="skeleton-line" style="width:80%"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .spotify-section {
    margin-bottom: 2.5rem;
  }

  .spotify-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .spotify-header__left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .spotify-header__title {
    font-size: 1.45rem;
  }

  .spotify-header__eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    color: color-mix(in srgb, var(--text-muted) 96%, white);
  }

  .spotify-icon {
    color: #1db954;
    filter: drop-shadow(0 0 14px rgba(29, 185, 84, 0.25));
  }

  .spotify-label {
    color: color-mix(in srgb, var(--text-faint) 98%, white);
  }

  .spotify-bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 880px) {
    .spotify-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 190px;
    }
  }

  :global(.spotify-bento__main) {
    grid-column: span 2;
    position: relative;
    display: flex;
    min-height: 260px;
    padding: 1.35rem;
    background: var(--spotify-card);
  }

  @media (min-width: 880px) {
    :global(.spotify-bento__main) {
      grid-row: span 2;
      min-height: auto;
      padding: 1.8rem;
    }
  }

  :global(.spotify-main__backdrop) {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  :global(.spotify-main__backdrop::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--spotify-overlay);
  }

  :global(.spotify-main__blur) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    filter: blur(24px) saturate(1.08);
    transform: scale(1.14);
  }

  :global(.spotify-main__mesh) {
    display: none;
  }

  :global(.spotify-main__content) {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: 100%;
  }

  :global(.spotify-main__top) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  :global(.spotify-main__artwrap) {
    position: relative;
    width: 96px;
    height: 96px;
  }

  @media (min-width: 880px) {
    :global(.spotify-main__artwrap) {
      width: 132px;
      height: 132px;
    }
  }

  :global(.spotify-main__art) {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  :global(.spotify-main__vinyl) {
    position: absolute;
    top: 50%;
    right: -24%;
    width: 82%;
    height: 82%;
    border-radius: 50%;
    transform: translateY(-50%);
    background: radial-gradient(circle, #191919 26%, #0e0e0e 28%, #242424 57%, #121212 60%);
    box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  :global(.spotify-main__status) {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--spotify-badge-border);
    background: var(--spotify-badge-bg);
    color: var(--spotify-badge-text);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }

  :global(.spotify-main__status .label-sm) {
    color: inherit;
  }

  :global(.eq-bars) {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  :global(.eq-bar) {
    width: 2px;
    border-radius: 999px;
    background: currentColor;
  }

  @keyframes eq-1 {
    0%,
    100% {
      height: 4px;
    }
    50% {
      height: 10px;
    }
  }

  @keyframes eq-2 {
    0%,
    100% {
      height: 8px;
    }
    50% {
      height: 3px;
    }
  }

  @keyframes eq-3 {
    0%,
    100% {
      height: 5px;
    }
    50% {
      height: 9px;
    }
  }

  :global(.eq-bar:nth-child(1)) {
    animation: eq-1 0.6s ease-in-out infinite;
  }

  :global(.eq-bar:nth-child(2)) {
    animation: eq-2 0.8s ease-in-out infinite;
  }

  :global(.eq-bar:nth-child(3)) {
    animation: eq-3 0.5s ease-in-out infinite;
  }

  :global(.spotify-main__status.is-paused .eq-bar) {
    animation-play-state: paused;
    height: 3px !important;
  }

  :global(.spotify-main__body) {
    margin-top: auto;
  }

  :global(.spotify-main__eyebrow) {
    display: inline-flex;
    margin-bottom: 0.65rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.22);
    color: color-mix(in srgb, var(--text-muted) 94%, white);
  }

  :global(.spotify-main__track) {
    color: var(--text-primary);
    font-family: var(--font-headline);
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    max-width: 18rem;
    text-wrap: balance;
    text-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);
  }

  :global(.spotify-main__artist) {
    margin-top: 0.45rem;
    color: color-mix(in srgb, var(--text-body) 94%, white);
    font-size: 0.98rem;
    text-shadow: 0 6px 20px rgba(0, 0, 0, 0.42);
  }

  :global(.spotify-main__progress) {
    margin-top: 1.2rem;
    height: 4px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--spotify-progress-bg);
  }

  :global(.spotify-main__progress-fill) {
    height: 100%;
    border-radius: inherit;
    background: var(--spotify-progress-fill);
    box-shadow: 0 0 18px color-mix(in srgb, var(--spotify-progress-fill) 35%, transparent);
    transition: width 1s linear;
  }

  :global(.spotify-bento__artist) {
    position: relative;
    overflow: hidden;
    min-height: 168px;
  }

  :global(.spotify-bento__artist::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--spotify-artist-scrim);
  }

  :global(.spotify-bento__artist-img),
  :global(.spotify-bento__artist-placeholder) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.spotify-bento__artist-img) {
    object-fit: cover;
    filter: grayscale(0.14) saturate(1.05);
    transition: transform var(--transition-slow), filter var(--transition-slow);
  }

  :global(.spotify-bento__artist:hover .spotify-bento__artist-img) {
    transform: scale(1.04);
    filter: grayscale(0) saturate(1.08);
  }

  :global(.spotify-bento__artist-placeholder) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-high) 100%);
    color: var(--text-primary);
    font-family: var(--font-headline);
    font-size: 4rem;
  }

  :global(.spotify-bento__artist-info) {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 1rem;
    text-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
    background: linear-gradient(180deg, transparent 0%, rgba(8, 8, 12, 0.54) 55%, rgba(8, 8, 12, 0.7) 100%);
  }

  :global(.spotify-bento__artist-name) {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-headline);
    font-size: 1.2rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  :global(.spotify-bento__artist-genre) {
    display: block;
    margin-top: 0.3rem;
    color: color-mix(in srgb, var(--text-body) 98%, white);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .spotify-now__loading {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    width: 100%;
  }

  .spotify-now__skeleton,
  .skeleton-line {
    background: linear-gradient(110deg, rgba(255, 255, 255, 0.06) 8%, rgba(255, 255, 255, 0.14) 18%, rgba(255, 255, 255, 0.06) 33%);
    background-size: 200% 100%;
    animation: spotify-shimmer 1.5s linear infinite;
  }

  .spotify-now__skeleton {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    border-radius: 18px;
  }

  .spotify-now__skeleton-text {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
  }

  .skeleton-line {
    height: 12px;
    border-radius: 999px;
  }

  @keyframes spotify-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotify-now__skeleton,
    .skeleton-line,
    :global(.eq-bar) {
      animation: none !important;
    }
  }
</style>

<script>
  const spotifySection = document.getElementById('spotify-widget');
  const spotifyGrid = document.getElementById('spotify-bento-grid');

  let spotifyPollId: number | undefined;
  let spotifyVisible = false;
  let spotifyHydrated = false;
  let lastSnapshot = '';

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function renderArtistImage(artist: any): string {
    const image = artist?.images?.[0]?.url;
    if (image) {
      return `<img class="spotify-bento__artist-img" src="${escapeHtml(image)}" alt="${escapeHtml(artist.name)}" loading="lazy" />`;
    }

    return `<div class="spotify-bento__artist-placeholder">${escapeHtml(artist.name?.charAt(0) || '?')}</div>`;
  }

  function getAlbumArt(item: any): string {
    return item?.album?.images?.[0]?.url || '';
  }

  function buildMainCard(data: any): string {
    if (data.currentlyPlaying?.item) {
      const track = data.currentlyPlaying.item;
      const albumArt = getAlbumArt(track);
      const isPlaying = Boolean(data.currentlyPlaying.is_playing);
      const progress = data.currentlyPlaying.progress_ms || 0;
      const duration = track.duration_ms || 1;
      const pct = Math.max(3, Math.round((progress / duration) * 100));
      const artistNames = (track.artists || []).map((artist: any) => artist.name).join(', ');

      return `
        <div class="spotify-bento__main card card-paper">
          <div class="spotify-main__backdrop">
            ${albumArt ? `<img class="spotify-main__blur" src="${escapeHtml(albumArt)}" alt="" />` : ''}
            <div class="spotify-main__mesh"></div>
          </div>
          <div class="spotify-main__content">
            <div class="spotify-main__top">
              <div class="spotify-main__artwrap">
                ${albumArt ? `<img class="spotify-main__art" src="${escapeHtml(albumArt)}" alt="Album cover" loading="lazy" />` : `<div class="spotify-main__art"></div>`}
                <div class="spotify-main__vinyl ${isPlaying ? 'vinyl-spin' : ''}"></div>
              </div>
              <div class="spotify-main__status ${isPlaying ? '' : 'is-paused'}">
                <div class="eq-bars">
                  <div class="eq-bar"></div>
                  <div class="eq-bar"></div>
                  <div class="eq-bar"></div>
                </div>
                <span class="label-sm">${isPlaying ? 'Playing now' : 'Paused'}</span>
              </div>
            </div>
            <div class="spotify-main__body">
              <span class="spotify-main__eyebrow label-sm">Currently in rotation</span>
              <div class="spotify-main__track">${escapeHtml(track.name)}</div>
              <div class="spotify-main__artist">${escapeHtml(artistNames)}</div>
              <div class="spotify-main__progress">
                <div class="spotify-main__progress-fill" style="width:${pct}%"></div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    if (data.recentlyPlayed?.items?.length) {
      const recent = data.recentlyPlayed.items[0].track;
      const albumArt = getAlbumArt(recent);
      const artistNames = (recent.artists || []).map((artist: any) => artist.name).join(', ');

      return `
        <div class="spotify-bento__main card card-paper">
          <div class="spotify-main__backdrop">
            ${albumArt ? `<img class="spotify-main__blur" src="${escapeHtml(albumArt)}" alt="" />` : ''}
            <div class="spotify-main__mesh"></div>
          </div>
          <div class="spotify-main__content">
            <div class="spotify-main__top">
              <div class="spotify-main__artwrap">
                ${albumArt ? `<img class="spotify-main__art" src="${escapeHtml(albumArt)}" alt="Album cover" loading="lazy" />` : `<div class="spotify-main__art"></div>`}
                <div class="spotify-main__vinyl"></div>
              </div>
              <div class="spotify-main__status is-paused">
                <span class="label-sm">Last played</span>
              </div>
            </div>
            <div class="spotify-main__body">
              <span class="spotify-main__eyebrow label-sm">Recent listen</span>
              <div class="spotify-main__track">${escapeHtml(recent.name)}</div>
              <div class="spotify-main__artist">${escapeHtml(artistNames)}</div>
              <div class="spotify-main__progress">
                <div class="spotify-main__progress-fill" style="width:100%"></div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    return `
      <div class="spotify-bento__main card card-paper">
        <div class="spotify-main__content" style="justify-content:flex-end">
          <span class="spotify-main__eyebrow label-sm">Signal offline</span>
          <div class="spotify-main__track">No recent Spotify activity</div>
          <div class="spotify-main__artist">The feed will return when something starts playing again.</div>
        </div>
      </div>
    `;
  }

  function buildArtistCards(data: any): string {
    const artists = data.topArtists?.items?.slice(0, 4) || [];
    return artists
      .map(
        (artist: any) => `
          <a href="${escapeHtml(artist.external_urls?.spotify || '#')}" target="_blank" rel="noopener" class="spotify-bento__artist card card-paper">
            ${renderArtistImage(artist)}
            <div class="spotify-bento__artist-info">
              <span class="spotify-bento__artist-name">${escapeHtml(artist.name)}</span>
              <span class="spotify-bento__artist-genre">${escapeHtml(artist.genres?.[0] || 'Artist')}</span>
            </div>
          </a>
        `
      )
      .join('');
  }

  async function renderSpotify(force = false) {
    if (!spotifyGrid || document.hidden || !spotifyVisible) return;

    try {
      const res = await fetch('/api/spotify');
      if (!res.ok) throw new Error('spotify');
      const data = await res.json();
      const snapshot = JSON.stringify({
        current: data.currentlyPlaying?.item?.id || null,
        playing: Boolean(data.currentlyPlaying?.is_playing),
        progress: data.currentlyPlaying?.progress_ms || 0,
        recent: data.recentlyPlayed?.items?.[0]?.track?.id || null,
        artists: (data.topArtists?.items || []).slice(0, 4).map((artist: any) => artist.id),
      });

      if (!force && snapshot === lastSnapshot) {
        return;
      }

      lastSnapshot = snapshot;
      spotifyGrid.innerHTML = buildMainCard(data) + buildArtistCards(data);
      spotifyHydrated = true;
    } catch {
      if (!spotifyHydrated && spotifyGrid) {
        spotifyGrid.innerHTML = `
          <div class="spotify-bento__main card card-paper">
            <div class="spotify-main__content" style="justify-content:flex-end">
              <span class="spotify-main__eyebrow label-sm">Feed unavailable</span>
              <div class="spotify-main__track">Spotify integration is resting</div>
              <div class="spotify-main__artist">The rest of the site stays fully interactive while this reconnects.</div>
            </div>
          </div>
        `;
      }
    }
  }

  function startSpotifyPolling() {
    if (spotifyPollId || !spotifyVisible || document.hidden) return;
    renderSpotify(!spotifyHydrated);
    spotifyPollId = window.setInterval(() => renderSpotify(), 30000);
  }

  function stopSpotifyPolling() {
    if (spotifyPollId) {
      clearInterval(spotifyPollId);
      spotifyPollId = undefined;
    }
  }

  if (spotifySection) {
    const spotifyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          spotifyVisible = entry.isIntersecting;
          if (spotifyVisible) {
            startSpotifyPolling();
          } else {
            stopSpotifyPolling();
          }
        });
      },
      { threshold: 0.2 }
    );

    spotifyObserver.observe(spotifySection);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopSpotifyPolling();
    } else if (spotifyVisible) {
      startSpotifyPolling();
    }
  });
</script>
