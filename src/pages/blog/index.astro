---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { formatBlogDate, getReadingTime, sortBlogPosts } from '../../lib/blog';

const posts = sortBlogPosts(await getCollection('blog'));
---

<BaseLayout title="Blog" description="Thoughts on design systems, software engineering, and digital minimalism." activePage="blog">
  <main class="blog-page container-narrow">
    <header class="blog-page__hero animate-on-scroll">
      <span class="label-upper">Collected essays</span>
      <h1 class="text-display blog-page__title">
        <span class="font-accent">Notes</span>
      </h1>
      <p class="blog-page__desc">
        Writing about anything and everything.
      </p>
    </header>

    <section class="blog-page__list animate-on-scroll stagger-1 deferred-section">
      {posts.length > 0 ? (
        posts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            date={formatBlogDate(post.data.pubDate)}
            description={post.data.description}
            tag={post.data.tags[0]}
            slug={post.id}
            readingTime={getReadingTime(post.body)}
          />
        ))
      ) : (
        <article class="blog-page__empty card">
          <span class="label-upper">Archive warming up</span>
          <h2 class="text-title blog-page__empty-title">No posts published yet.</h2>
          <p class="blog-page__empty-copy">
            More coming soon.
          </p>
          <div class="blog-page__empty-actions">
            <a href="/contact" class="btn-ghost">Open contact</a>
            <a href="/rss.xml" class="btn-subtle">Check RSS feed</a>
          </div>
        </article>
      )}
    </section>

    <section class="blog-page__rss animate-on-scroll stagger-2">
      <div class="blog-page__rss-card card card-paper">
        <div>
          <span class="label-upper">Stay in sync</span>
          <h2 class="text-title blog-page__rss-title">RSS Feed</h2>
        </div>
        <a href="/rss.xml" class="btn-ghost">
          <span class="material-symbols-outlined" style="font-size:16px">rss_feed</span>
          Open feed
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .blog-page {
    padding-top: 10rem;
    padding-bottom: 4rem;
  }

  .blog-page__hero {
    margin-bottom: 2rem;
  }

  .blog-page__title {
    margin-top: 0.7rem;
    font-size: clamp(3.3rem, 9vw, 5.2rem);
  }

  .blog-page__desc {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .blog-page__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .blog-page__rss-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
  }

  .blog-page__rss-title {
    margin-top: 0.45rem;
    font-size: 1.4rem;
  }

  .blog-page__empty {
    padding: 1.8rem;
  }

  .blog-page__empty-title {
    margin-top: 0.7rem;
    font-size: 1.65rem;
  }

  .blog-page__empty-copy {
    max-width: 38rem;
    margin-top: 0.8rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .blog-page__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 768px) {
    .blog-page__rss-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
