---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatBlogDate, getReadingTime, sortBlogPosts } from '../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const posts = sortBlogPosts(await getCollection('blog'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description} activePage="blog">
  <main class="post-page container-narrow">
    <header class="post-page__back animate-on-scroll">
      <a href="/blog" class="post-page__back-link">
        <span class="material-symbols-outlined" style="font-size:14px">arrow_back</span>
        Back to blog
      </a>
    </header>

    <article class="post-page__article animate-on-scroll stagger-1">
      <div class="post-page__hero card card-paper">
        <div class="post-page__hero-ornaments ornament-layer" aria-hidden="true">
          <span class="ornament-grid-mask"></span>
          <span class="ornament-scanline"></span>
          <span class="ornament-corner ornament-corner--tr"></span>
          <span class="ornament-corner ornament-corner--bl"></span>
          <span class="ornament-icon-node post-page__hero-icon">
            <span class="material-symbols-outlined">edit_note</span>
          </span>
          <span class="ornament-hairline post-page__hero-line"></span>
          <span class="ornament-dot post-page__hero-dot"></span>
        </div>
        <div class="post-page__hero-copy">
          <span class="label-upper">Essay</span>
          <h1 class="post-page__title text-display">{post.data.title}</h1>
          <div class="post-page__meta">
            <div class="post-page__meta-left">
              <span class="label-upper">{formatBlogDate(post.data.pubDate, 'long')}</span>
              <span class="post-page__meta-dot"></span>
              <span class="label-upper">{readingTime}</span>
            </div>
            <div class="post-page__tags">
              {post.data.tags.map((tag: string) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="post-page__content-wrap animate-on-scroll stagger-2">
        <div class="post-page__content-ornaments ornament-layer" aria-hidden="true">
          <span class="ornament-hairline post-page__content-line"></span>
          <span class="ornament-corner ornament-corner--tl"></span>
        </div>
        <div class="post-page__content prose">
        <Content />
        </div>
      </div>
    </article>

    <div class="post-page__footer animate-on-scroll stagger-3">
      <a href="/blog" class="post-page__back-link">
        <span class="material-symbols-outlined" style="font-size:14px">arrow_back</span>
        All posts
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  .post-page {
    padding-top: 9.5rem;
    padding-bottom: 4rem;
  }

  .post-page__back {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .post-page__back::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.6rem;
    width: 6rem;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--outline-strong) 68%, var(--accent)), transparent);
    opacity: 0.75;
  }

  .post-page__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .post-page__hero {
    position: relative;
    padding: 1.7rem;
    margin-bottom: 2rem;
  }

  .post-page__hero-copy {
    position: relative;
    z-index: 1;
    padding-left: 3.3rem;
  }

  .post-page__hero-line {
    left: 5.2rem;
    right: 38%;
    bottom: 1.1rem;
  }

  .post-page__hero-dot {
    top: 1.1rem;
    right: 1.4rem;
  }

  .post-page__hero-icon {
    top: 1.28rem;
    left: 1.45rem;
    width: 1.9rem;
    height: 1.9rem;
  }

  .post-page__title {
    max-width: 13ch;
    margin-top: 0.65rem;
    font-size: clamp(2.35rem, 6.5vw, 3.8rem);
    line-height: 1;
  }

  .post-page__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .post-page__meta-left {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .post-page__meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--outline-strong);
    box-shadow: 0 0 10px var(--accent-glow);
    animation: slow-pulse 3.6s ease-in-out infinite;
  }

  .post-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-page__content-wrap {
    position: relative;
    margin-bottom: 3rem;
  }

  .post-page__content-ornaments .ornament-corner {
    top: 0.2rem;
    left: -1.1rem;
  }

  .post-page__content-line {
    left: -0.5rem;
    top: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--outline-variant) 78%, white 22%), transparent);
    opacity: 0.45;
  }

  .post-page__content {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .post-page__footer {
    position: relative;
    padding-top: 2rem;
    border-top: 1px solid var(--outline);
  }

  .post-page__footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 8rem;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent-soft) 82%, white 18%), transparent);
  }

  @media (max-width: 768px) {
    .post-page__hero-copy {
      padding-top: 2.6rem;
      padding-left: 0;
    }

    .post-page__hero-line {
      left: 1.35rem;
      right: 1.35rem;
    }

    .post-page__hero-icon {
      top: 1rem;
      right: 1rem;
      left: auto;
    }

    .post-page__title {
      max-width: none;
      font-size: clamp(2.2rem, 11vw, 3rem);
    }

    .post-page__content-ornaments {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-page__meta-dot {
      animation: none;
    }
  }
</style>
