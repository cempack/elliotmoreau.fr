---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialLinks } from '../data/socials';

const pgpEmail = 'hello@elliotm.fr';
const pgpKeyFull = `-----BEGIN PGP PUBLIC KEY BLOCK-----

xjMEab2+ChYJKwYBBAHaRw8BAQdAevWjB0Qn2SFRIr5e0H+koAcM+w5boZ9W
