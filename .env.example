# GitHub — Projects app + last push. Optional but recommended (rate limits).
# Create at https://github.com/settings/tokens (classic, no scopes needed for public data).
GITHUB_TOKEN=

# Spotify — now playing (menu bar, Now app). Optional.
# Refresh token: run `node scripts/spotify-token.mjs`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Ghost blog — latest posts + newsletter subscribe (Admin key stays server-side).
GHOST_API_URL=
NEXT_PUBLIC_BLOG_URL=
GHOST_CONTENT_KEY=
GHOST_ADMIN_KEY=

# Dos Moos theme webhook (optional): a push to the theme repo updates the
# palette at once instead of within 10 minutes. See docs/RAILWAY.md (theme webhook).
# THEME_WEBHOOK_SECRET=

# Cloudflare Turnstile on the Mail app's Send (optional; both or neither).
# dash.cloudflare.com → Turnstile → Add widget: hostname elliotmoreau.fr (covers
# PR previews too), mode Managed. Locally, Cloudflare's test keys always pass:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Who a letter's IP belongs to (ISP or host, AS number), from ipinfo.io. Works
# without a token (rate-limited); a free token lifts the limit. IP_LOOKUP=off
# never asks (reverse DNS only).
# IPINFO_TOKEN=
# IP_LOOKUP=off

# Set to 1 to see empty states instead of sample data. (The real site, a production
# build with a public SITE_URL, never shows sample data: src/lib/deploy.ts.)
# EM_NO_FIXTURES=1
