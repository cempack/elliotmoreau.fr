# GitHub — Projects app + last push. Optional but recommended (rate limits).
# Create at https://github.com/settings/tokens (classic, no scopes needed for public data).
GITHUB_TOKEN=

# Spotify — now playing (menu bar, Now app). Optional.
# Refresh token: run `node scripts/spotify-token.mjs` (docs/RAILWAY.md).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Ghost blog — latest posts + newsletter subscribe (Admin key stays server-side).
GHOST_API_URL=
NEXT_PUBLIC_BLOG_URL=
GHOST_CONTENT_KEY=
GHOST_ADMIN_KEY=

# Dos Moos theme webhook (optional): a push to the theme repo updates the
# palette at once instead of within 10 minutes. See docs/RAILWAY.md.
# THEME_WEBHOOK_SECRET=

# Local only: set to 1 to see empty states instead of sample data.
# EM_NO_FIXTURES=1
