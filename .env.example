# GitHub — higher rate limits + private quota. Optional but recommended.
# Create at https://github.com/settings/tokens (classic, no scopes needed for public data).
GITHUB_TOKEN=

# Spotify — required for the "Signal" section on Home.
# See README for how to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Ghost blog — latest posts + newsletter subscribe (Admin key stays server-side).
GHOST_API_URL=
NEXT_PUBLIC_BLOG_URL=
GHOST_CONTENT_KEY=
GHOST_ADMIN_KEY=
